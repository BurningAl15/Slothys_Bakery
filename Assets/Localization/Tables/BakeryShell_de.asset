    m_Metadata:
      m_Items: []
  - m_Id: 1534058519
    m_Localized: "Wie viel ist {0} \xD7 {1}?"
    m_Metadata:
      m_Items: []
  - m_Id: 1534058520
    m_Localized: "Dies \xF6ffnet eine Seite au\xDFerhalb des Spiels."
