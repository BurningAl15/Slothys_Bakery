  - m_Id: 430929536344064
    m_Localized: Slothys Freunde
    m_Metadata:
      m_Items: []
  - m_Id: 430929536344065
    m_Localized: Neu!
    m_Metadata:
      m_Items: []
  - m_Id: 430929536344066
    m_Localized: Alle Spiele ansehen
    m_Metadata:
      m_Items: []
  - m_Id: 465575682760704
    m_Localized: Mein Diplom ansehen
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537920
    m_Localized: DIPLOM ALS
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537921
    m_Localized: Stern-Assistent
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537922
    m_Localized: Verliehen an
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537923
    m_Localized: Tippe, um deinen Namen einzugeben
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537924
    m_Localized: Spiel mit Slothy!
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537925
    m_Localized: Teilen
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537926
    m_Localized: Speichern
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537927
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537928
    m_Localized: Mein Slothy's Bakery-Diplom!
    m_Metadata:
      m_Items: []
  - m_Id: 465672902533120
    m_Localized: Stern-Assistent!
    m_Metadata:
      m_Items: []
  - m_Id: 465672919310336
    m_Localized: Du hast die Geschichte von Slothy's Bakery beendet!
    m_Metadata:
      m_Items: []
  - m_Id: 465672919310337
    m_Localized: "Zur\xFCck zum Start"
    m_Metadata:
      m_Items: []
  - m_Id: 465774685708288
    m_Localized: 'Beispiele: 2/2, 3/3, 4/4...'
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291200
    m_Localized: "Z\xE4hler und Nenner m\xFCssen gleich sein"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291201
    m_Localized: "Um Br\xFCche zu vergleichen, pr\xFCfen wir zuerst die Nenner"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291202
    m_Localized: "1. Sind sie gleich, vergleichen wir die Z\xE4hler"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291203
    m_Localized: 2. Sind sie verschieden, suchen wir einen gemeinsamen Nenner
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291204
    m_Localized: '- Dann vergleichen wir'
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291205
    m_Localized: <swing>1) Schneide das Dessert entlang der Linie</swing>
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291206
    m_Localized: Mit welchem Bruch den ersten multiplizieren, um die Nenner anzugleichen?
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291207
    m_Localized: "<swing>1) Ziehe ein Zeichen auf den Teller\n2) Tippe auf Pr\xFCfen</swing>"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291208
    m_Localized: "<swing>1) Schreibe den Bruch\n2) Tippe auf Pr\xFCfen</swing>"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291209
    m_Localized: "<bounce>Was ist die Entsprechung der gezeigten St\xFCcke?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291210
    m_Localized: Richtig!
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291211
    m_Localized: Versuch es nochmal
    m_Metadata:
      m_Items: []
  - m_Id: 506850981175296
    m_Localized: Gut gemacht!
    m_Metadata:
      m_Items: []
  - m_Id: 506851002146816
    m_Localized: Keine Fehler
    m_Metadata:
