    m_Metadata:
      m_Items: []
  - m_Id: 389659065573376
    m_Localized: Erfolge freigeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573377
    m_Localized: Erfolg freigeschaltet!
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573378
    m_Localized: "Serie \xD7{0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573379
    m_Localized: Freigeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573380
    m_Localized: Erste Bestellung
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573381
    m_Localized: "Schlie\xDFe dein erstes Minispiel ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573382
    m_Localized: "B\xE4ckerei in Schwung"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573383
    m_Localized: "Schlie\xDFe 10 Minispiele ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573384
    m_Localized: Perfekte Bestellung
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573385
    m_Localized: "Schlie\xDFe ein Minispiel fehlerfrei ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573386
    m_Localized: "Erste \xDCbung"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573387
    m_Localized: "Schlie\xDFe eine Themen\xFCbung ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573388
    m_Localized: Probiere jedes Rezept
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573389
    m_Localized: "\xDCbe alle drei Minispiele."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573390
    m_Localized: "Tagesb\xE4cker"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573391
    m_Localized: "Schlie\xDFe eine Tagesherausforderung ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573392
    m_Localized: Stammgast
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573393
    m_Localized: "Schlie\xDFe f\xFCnf Tagesherausforderungen ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573394
    m_Localized: Nachmittagsschicht
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573395
    m_Localized: "Schlie\xDFe eine Nachmittagsschicht ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573396
    m_Localized: Wahl des Chefs
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573397
    m_Localized: "Schlie\xDFe eine Runde im Chef-Modus ab."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573398
    m_Localized: "Zur\xFCck in der B\xE4ckerei"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573399
    m_Localized: Spiele an drei verschiedenen Tagen.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573400
    m_Localized: "Slothy wartet in der B\xE4ckerei auf dich"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573401
    m_Localized: "Es gibt eine neue Bruch-Aktivit\xE4t f\xFCr dich. Lust mitzumachen?"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573402
    m_Localized: Slothy vermisst deine Hilfe bei den heutigen Bestellungen.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573403
    m_Localized: "Die B\xE4ckerei hat noch offen. Slothy hat dir etwas aufgehoben."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573404
    m_Localized: Eine freundliche Erinnerung zum Weiterspielen.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573405
    m_Localized: <bounce>Sind ihre Nenner vergleichbar?</bounce>
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573406
    m_Localized: "<bounce>Mit welchem Bruch m\xFCssen wir den ersten Bruch multiplizieren, damit die Nenner vergleichbar sind?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573407
    m_Localized: <bounce>Welches Vergleichszeichen ist richtig?</bounce>
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573408
    m_Localized: "<bounce>Welcher Bruch k\xF6nnte den gezeigten Brotst\xFCcken entsprechen?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573409
    m_Localized: "<bounce>Welcher Bruch ist gr\xF6\xDFer als das gezeigte Dessertst\xFCck?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573410
    m_Localized: "<bounce>Welcher Bruch ist kleiner als das gezeigte Dessertst\xFCck?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389761456922624
    m_Localized: "Zur\xFCcksetzen"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699840
    m_Localized: Verstanden
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699841
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699842
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699843
    m_Localized: "Pr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699844
    m_Localized: Was ist der gleichwertige Wert von ____?
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699845
    m_Localized: "Pr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699846
    m_Localized: "Pr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699847
    m_Localized: Gib einen Bruch ein...
    m_Metadata:
      m_Items: []
  - m_Id: 411782614081536
    m_Localized: Mein Fortschritt
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441664
    m_Localized: Heute!
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441665
    m_Localized: Ansehen
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441666
    m_Localized: "W\xE4hle ein Thema zum \xDCben in deinem Tempo"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441667
    m_Localized: "Vergleiche Nenner, bevor du ein Zeichen w\xE4hlst"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441668
    m_Localized: "W\xE4hle gr\xF6\xDFer, kleiner oder gleich zwischen zwei Tabletts"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441669
    m_Localized: "Bilde einen gleichwertigen Bruch f\xFCr jedes Rezept"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441670
    m_Localized: Mein Fortschritt
    m_Metadata:
      m_Items: []
