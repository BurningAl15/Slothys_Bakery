  - m_Id: 1534058516
    m_Localized: Altri giochi di FatCat Game Studio
    m_Metadata:
      m_Items: []
  - m_Id: 1534058517
    m_Localized: Altri giochi in arrivo presto.
    m_Metadata:
      m_Items: []
  - m_Id: 1534058518
    m_Localized: Chiedi a un adulto
    m_Metadata:
      m_Items: []
  - m_Id: 1534058519
    m_Localized: "Quanto fa {0} \xD7 {1}?"
    m_Metadata:
      m_Items: []
  - m_Id: 1534058520
    m_Localized: Questo apre una pagina fuori dal gioco.
    m_Metadata:
      m_Items: []
  - m_Id: 1534058521
    m_Localized: Solo per adulti
    m_Metadata:
      m_Items: []
  - m_Id: 25434031906816
    m_Localized: "Modalit\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684032
    m_Localized: "Modalit\xE0 di gioco"
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684033
