  - m_Id: 389659044601856
    m_Localized: Pratica
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573376
    m_Localized: Obiettivi sbloccati
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573377
    m_Localized: Obiettivo sbloccato!
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573378
    m_Localized: "Serie \xD7{0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573379
    m_Localized: Sbloccato
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573380
    m_Localized: Primo ordine
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573381
    m_Localized: Completa il tuo primo minigioco.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573382
    m_Localized: Panetteria in moto
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573383
    m_Localized: Completa 10 minigiochi.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573384
    m_Localized: Ordine perfetto
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573385
    m_Localized: Completa un minigioco senza errori.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573386
    m_Localized: Prima pratica
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573387
    m_Localized: Completa una pratica per tema.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573388
    m_Localized: Prova ogni ricetta
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573389
    m_Localized: Esercitati in tutti e tre i minigiochi.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573390
    m_Localized: Fornaio del giorno
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573391
    m_Localized: Completa una sfida del giorno.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573392
    m_Localized: Cliente abituale
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573393
    m_Localized: Completa cinque sfide del giorno.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573394
    m_Localized: Turno pomeridiano
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573395
    m_Localized: Completa un turno pomeridiano.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573396
    m_Localized: Scelta dello chef
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573397
    m_Localized: "Completa una partita in Modalit\xE0 Chef."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573398
    m_Localized: Di nuovo in panetteria
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573399
    m_Localized: Gioca in tre giorni diversi.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573400
    m_Localized: Slothy ti aspetta in panetteria
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573401
    m_Localized: "C'\xE8 una nuova attivit\xE0 sulle frazioni per te. Vuoi provare?"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573402
    m_Localized: A Slothy manca il tuo aiuto con gli ordini di oggi.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573403
    m_Localized: "La panetteria \xE8 ancora aperta. Slothy ti ha tenuto qualcosa."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573404
    m_Localized: Un gentile promemoria per tornare a giocare.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573405
    m_Localized: <bounce>I loro denominatori sono confrontabili?</bounce>
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573406
    m_Localized: <bounce>Per quale frazione dobbiamo moltiplicare la prima per rendere i denominatori confrontabili?</bounce>
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573407
    m_Localized: "<bounce>Qual \xE8 il segno di confronto corretto?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573408
    m_Localized: <bounce>Quale frazione potrebbe essere equivalente ai pezzi di pane mostrati?</bounce>
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573409
    m_Localized: "<bounce>Quale frazione \xE8 maggiore della porzione di dolce mostrata?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573410
    m_Localized: "<bounce>Quale frazione \xE8 minore della porzione di dolce mostrata?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389761456922624
    m_Localized: Ripristina
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699840
    m_Localized: Capito
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699841
    m_Localized: "S\xEC"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699842
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699843
    m_Localized: Invia
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699844
    m_Localized: "Qual \xE8 il valore equivalente di ____?"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699845
    m_Localized: Controlla
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699846
    m_Localized: Invia
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699847
    m_Localized: Scrivi una frazione...
    m_Metadata:
      m_Items: []
  - m_Id: 411782614081536
    m_Localized: I miei progressi
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441664
    m_Localized: Oggi!
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441665
    m_Localized: Vedi
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441666
    m_Localized: Scegli un tema per esercitarti con calma
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441667
    m_Localized: Confronta i denominatori prima di scegliere il segno
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441668
    m_Localized: Scegli maggiore, minore o uguale tra due vassoi
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441669
    m_Localized: Costruisci una frazione equivalente per ogni ricetta
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441670
    m_Localized: I miei progressi
    m_Metadata:
      m_Items: []
