    m_Metadata:
      m_Items: []
  - m_Id: 465575699537920
    m_Localized: DIPLOMA DI
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537921
    m_Localized: Assistente stella
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537922
    m_Localized: Assegnato a
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537923
    m_Localized: Tocca e scrivi il tuo nome
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537924
    m_Localized: Gioca con Slothy!
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537925
