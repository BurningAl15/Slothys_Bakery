    m_Metadata:
      m_Items: []
  - m_Id: 25434048684034
    m_Localized: Sfide
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684035
    m_Localized: Confronto a passi
    m_Metadata:
      m_Items: []
