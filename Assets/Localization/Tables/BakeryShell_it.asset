    m_Localized: Turno pomeridiano
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684040
    m_Localized: "Modalit\xE0 Chef"
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684041
    m_Localized: Obiettivi
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684042
    m_Localized: Vedi nel negozio
    m_Metadata:
      m_Items: []
  - m_Id: 25434048684043
