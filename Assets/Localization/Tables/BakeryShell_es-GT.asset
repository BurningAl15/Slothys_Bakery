  - m_Id: 389659044601856
    m_Localized: "Pr\xE1ctica"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573376
    m_Localized: Logros desbloqueados
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573377
    m_Localized: "\xA1Logro desbloqueado!"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573378
    m_Localized: "\xA1Racha \xD7{0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573379
    m_Localized: Desbloqueado
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573380
    m_Localized: Primer pedido
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573381
    m_Localized: Completa tu primer minijuego.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573382
    m_Localized: "Panader\xEDa en marcha"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573383
    m_Localized: Completa 10 minijuegos.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573384
    m_Localized: Pedido perfecto
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573385
    m_Localized: Completa un minijuego sin errores.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573386
    m_Localized: "Primera pr\xE1ctica"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573387
    m_Localized: "Completa una pr\xE1ctica por tema."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573388
    m_Localized: Prueba cada receta
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573389
    m_Localized: Practica los tres minijuegos.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573390
    m_Localized: "H\xE1bito diario"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573391
    m_Localized: Completa un reto diario.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573392
    m_Localized: Cliente habitual
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573393
    m_Localized: Completa cinco retos diarios.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573394
    m_Localized: Turno de tarde
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573395
    m_Localized: Completa un turno de tarde.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573396
    m_Localized: A prueba de chef
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573397
    m_Localized: Completa una partida en Modo Chef.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573398
    m_Localized: "De vuelta en la panader\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573399
    m_Localized: "Juega en tres d\xEDas distintos."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573400
    m_Localized: "Slothy te espera en la panader\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573401
    m_Localized: "Hay una nueva actividad de fracciones para ti. \xBFTe animas?"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573402
    m_Localized: "Slothy extra\xF1a ayudarte con los pedidos."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573403
    m_Localized: "La panader\xEDa sigue abierta. Slothy guard\xF3 algo para ti."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573404
    m_Localized: Un recordatorio amable para volver a jugar.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573405
    m_Localized: "<bounce>\xBFSe pueden comparar sus denominadores?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573406
    m_Localized: "<bounce>\xBFPor qu\xE9 fracci\xF3n debemos multiplicar la primera para que los denominadores sean comparables?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573407
    m_Localized: "<bounce>\xBFCu\xE1l es el signo de comparaci\xF3n correcto?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573408
    m_Localized: "<bounce>\xBFQu\xE9 fracci\xF3n podr\xEDa ser equivalente a las porciones de pan que se muestran?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573409
    m_Localized: "<bounce>\xBFQu\xE9 fracci\xF3n es mayor que la porci\xF3n de postre que se muestra?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573410
    m_Localized: "<bounce>\xBFQu\xE9 fracci\xF3n es menor que la porci\xF3n de postre que se muestra?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389761456922624
    m_Localized: Reiniciar
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699840
    m_Localized: Entendido
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699841
    m_Localized: "S\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699842
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699843
    m_Localized: Comprobar
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699844
    m_Localized: "\xBFCu\xE1l es el valor equivalente de ____?"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699845
    m_Localized: Comprobar
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699846
    m_Localized: Comprobar
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699847
    m_Localized: "Escribe una fracci\xF3n..."
    m_Metadata:
      m_Items: []
  - m_Id: 411782614081536
    m_Localized: Mi progreso
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441664
    m_Localized: "\xA1Hoy!"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441665
    m_Localized: Ver
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441666
    m_Localized: Elige un tema para repasar sin prisas
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441667
    m_Localized: Compara denominadores antes de elegir el signo
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441668
    m_Localized: Elige mayor, menor o igual entre dos porciones
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441669
    m_Localized: "Arma la fracci\xF3n equivalente de cada receta"
    m_Metadata:
      m_Items: []
