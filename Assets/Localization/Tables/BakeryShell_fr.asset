    m_Localized: "D'autres jeux arrivent bient\xF4t."
    m_Metadata:
      m_Items: []
  - m_Id: 1534058518
    m_Localized: "Demande \xE0 un adulte"
    m_Metadata:
      m_Items: []
  - m_Id: 1534058519
    m_Localized: "Combien font {0} \xD7 {1} ?"
    m_Metadata:
      m_Items: []
