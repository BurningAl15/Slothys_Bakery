    m_Metadata:
      m_Items: []
  - m_Id: 389659065573376
    m_Localized: "Succ\xE8s d\xE9bloqu\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573377
    m_Localized: "Succ\xE8s d\xE9bloqu\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573378
    m_Localized: "S\xE9rie \xD7{0} !"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573379
    m_Localized: "D\xE9bloqu\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573380
    m_Localized: "Premi\xE8re commande"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573381
    m_Localized: Termine ton premier mini-jeu.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573382
    m_Localized: Boulangerie en marche
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573383
    m_Localized: Termine 10 mini-jeux.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573384
    m_Localized: Commande parfaite
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573385
    m_Localized: Termine un mini-jeu sans erreur.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573386
    m_Localized: "Premi\xE8re pratique"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573387
    m_Localized: "Termine une pratique par th\xE8me."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573388
    m_Localized: Essaie chaque recette
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573389
    m_Localized: Pratique les trois mini-jeux.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573390
    m_Localized: Boulanger du jour
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573391
    m_Localized: "Termine un d\xE9fi du jour."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573392
    m_Localized: "Client fid\xE8le"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573393
    m_Localized: "Termine cinq d\xE9fis du jour."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573394
    m_Localized: "Service de l'apr\xE8s-midi"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573395
    m_Localized: "Termine un service de l'apr\xE8s-midi."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573396
    m_Localized: Choix du chef
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573397
    m_Localized: Termine une partie en Mode Chef.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573398
    m_Localized: "De retour \xE0 la boulangerie"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573399
    m_Localized: "Joue pendant trois jours diff\xE9rents."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573400
    m_Localized: "Slothy t'attend \xE0 la boulangerie"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573401
    m_Localized: "Une nouvelle activit\xE9 de fractions t'attend. Tu essaies ?"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573402
    m_Localized: "Tu manques \xE0 Slothy pour les commandes d'aujourd'hui."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573403
    m_Localized: "La boulangerie est encore ouverte. Slothy t'a gard\xE9 quelque chose."
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573404
    m_Localized: Un petit rappel pour revenir jouer.
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573405
    m_Localized: "<bounce>Leurs d\xE9nominateurs sont-ils comparables ?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573406
    m_Localized: "<bounce>Par quelle fraction devons-nous multiplier la premi\xE8re pour comparer les d\xE9nominateurs ?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573407
    m_Localized: <bounce>Quel est le bon signe de comparaison ?</bounce>
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573408
    m_Localized: "<bounce>Quelle fraction pourrait \xEAtre \xE9quivalente aux morceaux de pain affich\xE9s ?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573409
    m_Localized: "<bounce>Quelle fraction est plus grande que la part de dessert affich\xE9e ?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389659065573410
    m_Localized: "<bounce>Quelle fraction est plus petite que la part de dessert affich\xE9e ?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 389761456922624
    m_Localized: "R\xE9initialiser"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699840
    m_Localized: Compris
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699841
    m_Localized: Oui
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699842
    m_Localized: Non
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699843
    m_Localized: Valider
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699844
    m_Localized: "Quelle est la valeur \xE9quivalente de ____ ?"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699845
    m_Localized: "V\xE9rifier"
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699846
    m_Localized: Valider
    m_Metadata:
      m_Items: []
  - m_Id: 389761473699847
    m_Localized: "\xC9cris une fraction..."
    m_Metadata:
      m_Items: []
  - m_Id: 411782614081536
    m_Localized: "Mes progr\xE8s"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441664
    m_Localized: Aujourd'hui !
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441665
    m_Localized: Voir
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441666
    m_Localized: "Choisis un th\xE8me pour t'entra\xEEner \xE0 ton rythme"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441667
    m_Localized: "Compare les d\xE9nominateurs avant de choisir un signe"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441668
    m_Localized: "Choisis plus grand, plus petit ou \xE9gal entre deux plateaux"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441669
    m_Localized: "Construis une fraction \xE9quivalente pour chaque recette"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441670
    m_Localized: "Mes progr\xE8s"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441671
    m_Localized: Histoire
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441672
    m_Localized: "Service de l'apr\xE8s-midi"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441673
    m_Localized: Mode chef
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441674
    m_Localized: "D\xE9fi du jour"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441675
    m_Localized: Pratique
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441676
    m_Localized: "Succ\xE8s"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441677
    m_Localized: "Termin\xE9e !"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441678
    m_Localized: 'En cours : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441679
    m_Localized: "Jou\xE9 {0} fois"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441680
    m_Localized: 'Ouvert : essaie-le !'
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441681
    m_Localized: Termine l'histoire pour l'ouvrir
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441682
    m_Localized: "Termine le service de l'apr\xE8s-midi pour l'ouvrir"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441683
    m_Localized: '{0} sur {1} obtenus'
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441684
    m_Localized: "Voir les succ\xE8s"
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441685
    m_Localized: Obtenu !
    m_Metadata:
      m_Items: []
  - m_Id: 411782643441686
    m_Localized: "{0} sur {1} succ\xE8s d\xE9bloqu\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 430929523761152
    m_Localized: Avis d'enseignants
    m_Metadata:
      m_Items: []
  - m_Id: 430929536344064
    m_Localized: Amis de Slothy
    m_Metadata:
      m_Items: []
  - m_Id: 430929536344065
    m_Localized: Nouveau !
    m_Metadata:
      m_Items: []
  - m_Id: 430929536344066
    m_Localized: Voir tous les jeux
    m_Metadata:
      m_Items: []
  - m_Id: 465575682760704
    m_Localized: "Voir mon dipl\xF4me"
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537920
    m_Localized: "DIPL\xD4ME DE"
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537921
    m_Localized: "Assistant \xE9toile"
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537922
    m_Localized: "D\xE9cern\xE9 \xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537923
    m_Localized: "Touche pour \xE9crire ton nom"
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537924
    m_Localized: Joue avec Slothy !
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537925
    m_Localized: Partager
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537926
    m_Localized: Enregistrer
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537927
    m_Localized: Fermer
    m_Metadata:
      m_Items: []
  - m_Id: 465575699537928
    m_Localized: "Mon dipl\xF4me de Slothy's Bakery !"
    m_Metadata:
      m_Items: []
  - m_Id: 465672902533120
    m_Localized: "Assistant \xE9toile !"
    m_Metadata:
      m_Items: []
  - m_Id: 465672919310336
    m_Localized: "Tu as termin\xE9 l'histoire de Slothy's Bakery !"
    m_Metadata:
      m_Items: []
  - m_Id: 465672919310337
    m_Localized: "Retour \xE0 l'accueil"
    m_Metadata:
      m_Items: []
  - m_Id: 465774685708288
    m_Localized: 'Exemples : 2/2, 3/3, 4/4...'
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291200
    m_Localized: "Le num\xE9rateur et le d\xE9nominateur doivent \xEAtre \xE9gaux"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291201
    m_Localized: "Pour comparer des fractions, regardons d'abord les d\xE9nominateurs"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291202
    m_Localized: "1. S'ils sont \xE9gaux, on compare les num\xE9rateurs"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291203
    m_Localized: "2. S'ils sont diff\xE9rents, on cherche un d\xE9nominateur commun"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291204
    m_Localized: '- Ensuite, on compare'
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291205
    m_Localized: <swing>1) Coupe le dessert le long de la ligne</swing>
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291206
    m_Localized: "Par quelle fraction multiplier la premi\xE8re pour \xE9galiser les d\xE9nominateurs ?"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291207
    m_Localized: "<swing>1) Glisse un signe sur l'assiette\n2) Touche V\xE9rifier</swing>"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291208
    m_Localized: "<swing>1) \xC9cris la fraction\n2) Touche Valider</swing>"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291209
    m_Localized: "<bounce>Quelle est l'\xE9quivalence des parts affich\xE9es ?</bounce>"
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291210
    m_Localized: Bravo !
    m_Metadata:
      m_Items: []
  - m_Id: 465774698291211
    m_Localized: Essaie encore
    m_Metadata:
      m_Items: []
  - m_Id: 506850981175296
    m_Localized: "Bien jou\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 506851002146816
    m_Localized: Aucune erreur
    m_Metadata:
      m_Items: []
